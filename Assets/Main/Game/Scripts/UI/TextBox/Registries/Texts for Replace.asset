    Data:
      Text: A mailbox.[pause=0.3] There's a letter inside.<page> [mute]<i><color=#FFFFFF>"Darling,[pause=0.3]
        come home soon.[pause=0.3] I'm waiting [shake=2:10:1]for you.[pause=0.4]
        [progressive=1:2:2][easespeed=12]With love,[pause=0.15] <color=#F200FF>Ev</color>[\shake][pause=0.2] 
        [event=0][replacetext=2:48][\easespeed][\progressive]</color></i>[\mute]
